# Copiez ce fichier en ".env" et remplissez les valeurs.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub.

PORT=3000
# Longue phrase aléatoire (au moins 32 caractères)
SESSION_SECRET=
# L'identifiant du Google Sheet (dans son adresse, entre /d/ et /edit)
GOOGLE_SHEET_ID=
# Le fichier JSON du compte de service Google, encodé en base64 (une seule ligne)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Lien de la page produit Chariow où le client paie
CHARIOW_PRODUCT_URL=
# Secret du Pulse (Chariow > Automatisations > Pulses)
CHARIOW_PULSE_SECRET=
WHATSAPP_NUMBER=24162671445
# Adresse publique du site, sans / à la fin (ex. https://dwts.up.railway.app)
SITE_URL=http://localhost:3000
